<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext is allowed so a backend on your own Wi-Fi (http://192.168.x.x:8787)
     and older http-only RSS feeds work. Use HTTPS for any public deployment. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
