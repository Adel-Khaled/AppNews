# Copy to .env and fill in what you have. Every provider is optional; missing ones are skipped.

PORT=8787
# Shared token the app sends as X-App-Token. Set it in the app under Settings → Backend.
# It is not a secret (it ships in your APK settings) — it just stops random traffic.
APP_TOKEN=change-me-to-a-long-random-string

# --- News APIs (https://newsapi.org, https://gnews.io, https://open-platform.theguardian.com)
NEWSAPI_KEY=
GNEWS_KEY=
GUARDIAN_KEY=

# Extra RSS feeds processed server-side: "category|url" pairs separated by commas
BACKEND_RSS_FEEDS=

# --- Video: YouTube Data API v3 (Google Cloud Console → APIs & Services → YouTube Data API v3)
YOUTUBE_API_KEY=

# --- AI summaries / Explain This News (https://console.anthropic.com)
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5

# --- Facebook Pages via Graph API (needs a Page access token with permission for the page)
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_GRAPH_VERSION=v21.0
